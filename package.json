{
  "name": "dsh-session-move",
  "version": "0.1.0",
  "description": "侧栏工作区文件夹（分组）与会话移动 · Workspace folders and session move for DeepSeek Harness",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "license": "MIT",
  "author": "ayachinene285",
  "repository": {
    "type": "git",
    "url": "https://github.com/ayachinene285/dsh-session-move.git"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "workspace",
    "session",
    "sidebar",
    "folder"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-workspace",
        "@deepseek-ai/dsh-client-ui-primitives"
      ],
      "platform": "web"
    }
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md"
  ]
}
